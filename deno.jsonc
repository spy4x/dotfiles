{
  "imports": {
    "@spy4x/platform": "jsr:@spy4x/platform@1.9.0",
    "@spy4x/validation": "jsr:@spy4x/validation@1.9.0",
    "arktype": "npm:arktype@2.2.3"
  },
  "tasks": {
    "install-all": "deno task install-apps && deno task install-shell",
    "install-apps": "deno run -A install-apps.ts",
    "install-shell": "deno run -A install-shell.ts",
    "configure-hibernate": "deno run -A configure-hibernate-on-fedora-btrfs.ts",
    "ai": "deno run -A ai-harnesses/manage.ts",
    "test": "deno test -A tools/ ai-harnesses/",
    // Experiment kit: lanes.jsonl from transcripts, then the analysis. See tools/experiments/README.md.
    "experiment:collect": "deno run -A tools/experiments/collect.ts",
    "experiment:analyse": "deno run -A tools/experiments/analyse.ts",
    "experiment:report": "deno run -A tools/experiments/report.ts",
    "experiment:daily": "deno run -A tools/experiments/daily.ts",
    "experiment:trial": "deno run -A tools/experiments/trial.ts",
    "experiment:followup": "deno run -A tools/experiments/followup.ts",
    // age64 env files: every .env* in the repo <-> its committed .env*.age, key in .age/key.txt.
    "env:encrypt": "deno run --no-prompt -R -W=. jsr:@spy4x/server@1.2.0/env-age64/cli encrypt",
    "env:decrypt": "deno run --no-prompt -R -W=. jsr:@spy4x/server@1.2.0/env-age64/cli decrypt",
    "env:status": "deno run --no-prompt -R jsr:@spy4x/server@1.2.0/env-age64/cli status"
  },
  "exclude": [
    "**/.cache/*",
    "**/dist/*",
    ".volumes",
    ".git",
    "node_modules",
    "dist",
    "build",
    "docs",
    "infra",
    "*.lock",
    // Golden files are compared byte for byte; the formatter must not touch them.
    "ai-harnesses/fixtures/golden",
    // Apps rewrite these on every save; formatting them only churns.
    ".config/nvim/lazy-lock.json",
    ".config/nvim/lazyvim.json",
    ".config/obs-studio/basic",
    ".config/obs-studio/plugin_manager"
  ],
  // Mods are tested by `claude plugin test`: their tests import `claude-code/testing`, which only
  // that runner provides.
  "test": {
    "exclude": ["ai-harnesses/settings/claude/mods"]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve",
    "semiColons": false
  }
}
