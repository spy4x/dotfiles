// MCP servers for every harness. `deno task ai` renders each one into OpenCode's `mcp` and into
// Claude Code's `mcpServers` (in `~/.claude.json`). See README → "MCP servers".
{
  // Off until spy4x/caldav-mcp#14 stops it damaging tasks on update. Then drop `enabled`.
  // OpenCode gets it with `enabled: false`; Claude Code has no off switch, so it gets nothing.
  "caldav": { "command": "~/sync/code/mcps/caldav/start.sh", "enabled": false },
  "playwright": {
    "command": "npx",
    "args": [
      "@playwright/mcp@latest",
      "--browser",
      "chromium",
      "--headless",
      "--timeout-navigation",
      "300000"
    ],
    "targets": ["opencode"],
    "harness": { "opencode": { "timeout": 300000 } }
  }
}
