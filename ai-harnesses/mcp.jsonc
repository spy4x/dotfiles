// MCP servers for every harness. `deno task ai` renders each one into OpenCode's `mcp` and into
// Claude Code's `mcpServers` (in `~/.claude.json`). See README → "MCP servers".
{
  // The owner's tasks and calendars on Stalwart. Edits patch the original iCalendar text, so
  // reminders and fields Tasks.org wrote survive (spy4x/caldav-mcp#14, fixed by #18).
  "caldav": { "command": "~/sync/code/mcps/caldav/start.sh" },
  "playwright": {
    "command": "npx",
    "args": [
      "@playwright/mcp@0.0.83",
      "--browser",
      "chromium",
      "--headless",
      "--timeout-navigation",
      "300000"
    ],
    "targets": ["opencode"],
    "harness": { "opencode": { "timeout": 300000 } }
  }
}
