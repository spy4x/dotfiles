{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M3",
  "permission": "allow",
  "default_agent": "architect",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "*.log"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--timeout-navigation",
        "300000"
      ],
      "enabled": true,
      "timeout": 300000
    }
  }
}
