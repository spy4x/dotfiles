{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --no-config --no-lock --allow-read --allow-env=HOME --allow-run=git,gitleaks \"$HOME/.claude/hooks/guard-git.ts\"",
            "timeout": 120,
            "statusMessage": "guard-git"
          },
          {
            "type": "command",
            "if": "Bash(kill *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(pkill *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(killall *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(/bin/kill *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(/usr/bin/kill *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(/usr/bin/pkill *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(/usr/bin/killall *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(systemctl *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(loginctl *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(shutdown *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(reboot *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(poweroff *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(halt *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          },
          {
            "type": "command",
            "if": "Bash(sudo *)",
            "command": "deno run --no-config --no-lock --allow-read --allow-run=pgrep,ps \"$HOME/.claude/hooks/guard-kill.ts\"",
            "timeout": 15,
            "statusMessage": "guard-kill"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --no-config --no-lock --allow-read --allow-write --allow-env=HOME --allow-run=git \"$HOME/.claude/hooks/worktree.ts\" create",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --no-config --no-lock --allow-read --allow-write --allow-env=HOME --allow-run=git \"$HOME/.claude/hooks/worktree.ts\" remove",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
