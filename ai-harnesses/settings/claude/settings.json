{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactWindow": 250000,
  "autoContinueAtUsageLimit": true,
  "bashOutputMaxChars": 12000,
  "effortLevel": "medium",
  "skillOverrides": {
    "chrome-browser": "off",
    "computer-use": "off",
    "docx": "off",
    "google-workspace": "off",
    "import-memory": "off",
    "morning": "off",
    "pptx": "off",
    "xlsx": "off"
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/harness-rules"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(//**/.age/**)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Solo developer workstation: software development plus automation of the owner's own self-hosted servers",
      "Source control: github.com/spy4x and all repos under it"
    ]
  }
}
