{
  "model": "some/model",
  "mcp": {
    "lookup": {
      "type": "local",
      "command": [
        "~/bin/lookup",
        "--stdio"
      ],
      "environment": {
        "TOKEN_FILE": "~/token"
      },
      "enabled": true
    },
    "paused": {
      "type": "local",
      "command": [
        "paused-server"
      ],
      "enabled": false
    },
    "web": {
      "type": "local",
      "command": [
        "npx",
        "web-mcp"
      ],
      "enabled": true,
      "timeout": 5
    }
  }
}
