# Logitech C922: hold 30 fps in dim light. Its auto exposure lowers the frame rate by default
# (exposure_dynamic_framerate=1), which shows up as stutter in OBS recordings. Needs v4l-utils.
ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="085c", ATTR{index}=="0", RUN+="/usr/bin/v4l2-ctl --device $devnode --set-ctrl exposure_dynamic_framerate=0"
