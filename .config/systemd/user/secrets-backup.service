# Backs up the age keys and plaintext env files under ~/sync/code with restic.
# Runs from secrets-backup.timer. Setup and restore: docs/sync.md.
[Unit]
Description=Back up age keys and env files with restic
# A failed run shows an error dialog, so it never fails unnoticed night after night.
OnFailure=secrets-backup-failed.service

[Service]
Type=oneshot
ExecStart=%h/sync/code/dotfiles/tools/secrets-backup.sh
