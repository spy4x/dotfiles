# Backs up the agent-run database with restic, encrypted, while it is in use.
# Runs from agent-backup.timer. Setup and restore: docs/sync.md.
[Unit]
Description=Back up the agent-run database with restic
# A failed run sends an urgent push, so it never fails unnoticed night after night.
OnFailure=agent-backup-failed.service

[Service]
Type=oneshot
ExecStart=%h/sync/code/dotfiles/tools/agent-backup.sh
