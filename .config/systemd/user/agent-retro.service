# Starts the background lead's daily read-only retro. Runs from agent-retro.timer; the retro runs
# in its own agent-run-<id> unit. See docs/headless-runs.md.
[Unit]
Description=Start the background lead's daily retro

[Service]
Type=oneshot
ExecStart=/usr/bin/env deno run -A %h/sync/code/dotfiles/tools/agent-run.ts retro
