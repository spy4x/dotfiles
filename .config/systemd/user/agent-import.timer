# Runs agent-import.service every 10 minutes. A missed tick is not caught up: the next one reads
# everything since the last. See docs/headless-runs.md, "Session database".
[Unit]
Description=Import Claude Code transcripts every 10 minutes

[Timer]
OnCalendar=*:0/10
Persistent=false

[Install]
WantedBy=timers.target
