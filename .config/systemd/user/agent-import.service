# Imports new Claude Code transcript lines into the run database (~/.local/state/agent-run).
# Runs from agent-import.timer. See docs/headless-runs.md, "Session database".
[Unit]
Description=Import Claude Code transcripts into the run database

[Service]
Type=oneshot
# Stops a stuck import before the next tick is due.
TimeoutStartSec=9min
ExecStart=/usr/bin/env deno run -A %h/sync/code/dotfiles/tools/agent-import.ts
