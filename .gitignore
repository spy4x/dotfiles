# Playwright MCP runtime cache (session logs, page snapshots)
.playwright-mcp/

# Former AI harness homes. ~/.config/opencode and ~/.local/share/dsh were symlinks into
# these paths; ignore any leftover so a session, lockfile or credential never gets committed.
# Tracked harness config lives in ai-harnesses/.
/.config/opencode/
/.dsh/

# OBS Studio
# Track: profiles (basic/profiles/), scenes (basic/scenes/),
#   plugin_config/ (except the obs-websocket config),
#   plugin_manager/ (which plugins are enabled).
# Skip: runtime crash logs, profiler dumps, .bak scene backups,
#   rtmp-services/ (auto-refetched ingest data — re-pulled by OBS
#   on launch if missing, so no point tracking it).
.config/obs-studio/basic/scenes/*.bak
.config/obs-studio/basic/profiles/*/service.json
/.config/obs-studio/plugin_config/rtmp-services/
# obs-websocket config holds the server password; OBS generates it
# per install, so nothing in it is worth sharing across machines.
/.config/obs-studio/plugin_config/obs-websocket/config.json
# Scene files carry a PipeWire `RestoreToken` that changes every launch.
# gitignore cannot match inside JSON: accept the diff noise.
# .gitleaks.toml allowlists it — it is not a credential.

# Claude Code project-local state for sessions opened in this repo
.claude/settings.local.json
.claude/worktrees/
